{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.wizpay.xyz/schemas/common.schema.json",
  "title": "WizPay MCP common public types",
  "$defs": {
    "opaqueId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,15}_[A-Za-z0-9_-]{8,128}$"},
    "uuid": {"type": "string", "format": "uuid"},
    "chainId": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "evmAddress": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "transactionHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "uintString": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 79},
    "decimalString": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "maxLength": 100},
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decimal", "base_units", "decimals"],
      "properties": {
        "decimal": {"$ref": "#/$defs/decimalString"},
        "base_units": {"$ref": "#/$defs/uintString"},
        "decimals": {"type": "integer", "minimum": 0, "maximum": 36}
      },
      "description": "decimal and base_units must be semantically equal at the stated decimals"
    },
    "token": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["chain_id", "standard", "symbol", "decimals"],
          "properties": {
            "chain_id": {"$ref": "#/$defs/chainId"},
            "standard": {"const": "NATIVE"},
            "symbol": {"type": "string", "pattern": "^[A-Z0-9]{2,16}$"},
            "decimals": {"type": "integer", "minimum": 0, "maximum": 36}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["chain_id", "standard", "address", "symbol", "decimals"],
          "properties": {
            "chain_id": {"$ref": "#/$defs/chainId"},
            "standard": {"const": "ERC20"},
            "address": {"$ref": "#/$defs/evmAddress"},
            "symbol": {"type": "string", "pattern": "^[A-Z0-9]{2,16}$"},
            "decimals": {"type": "integer", "minimum": 0, "maximum": 36}
          }
        }
      ]
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "amount"],
      "properties": {
        "recipient_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "address": {"$ref": "#/$defs/evmAddress"},
        "amount": {"$ref": "#/$defs/amount"},
        "memo": {"type": "string", "minLength": 1, "maxLength": 140}
      }
    },
    "deadline": {"type": "string", "format": "date-time"},
    "basisPoints": {"type": "integer", "minimum": 0, "maximum": 10000}
  }
}

