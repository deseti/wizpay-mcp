{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.wizpay.xyz/schemas/transaction-intent.schema.json",
  "title": "Canonical immutable transaction intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_id", "intent_version", "owner", "wallet", "operation_type", "financial", "route", "constraints", "nonce", "client_request_id", "created_at", "expires_at", "intent_digest", "execution_state"],
  "properties": {
    "intent_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
    "intent_version": {"const": 1},
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["user_id", "identity_provider", "identity_subject_ref"],
      "properties": {
        "user_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "identity_provider": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "identity_subject_ref": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,256}$"}
      }
    },
    "wallet": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "binding_version", "circle_user_ref", "circle_wallet_id", "wallet_address", "chain_id"],
      "properties": {
        "binding_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "binding_version": {"type": "integer", "minimum": 1},
        "circle_user_ref": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
        "circle_wallet_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
        "wallet_address": {"$ref": "common.schema.json#/$defs/evmAddress"},
        "chain_id": {"$ref": "common.schema.json#/$defs/chainId"}
      }
    },
    "operation_type": {"enum": ["PAYROLL", "SWAP", "BRIDGE", "ANS_REGISTRATION", "WITHDRAWAL"]},
    "financial": {
      "oneOf": [
        {"$ref": "#/$defs/payroll"},
        {"$ref": "#/$defs/swap"},
        {"$ref": "#/$defs/bridge"},
        {"$ref": "#/$defs/ans"},
        {"$ref": "#/$defs/withdrawal"}
      ]
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["route_type", "route_id", "route_version"],
      "properties": {
        "route_type": {"enum": ["DIRECT_WALLET", "ALLOWLISTED_CONTRACT", "APPROVED_PROVIDER"]},
        "route_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
        "route_version": {"type": "integer", "minimum": 1},
        "provider_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
        "contract_address": {"$ref": "common.schema.json#/$defs/evmAddress"},
        "function_id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\([^)]*\\))?$", "maxLength": 256},
        "quote_or_plan_id": {"$ref": "common.schema.json#/$defs/opaqueId"}
      },
      "allOf": [
        {"if": {"properties": {"route_type": {"const": "ALLOWLISTED_CONTRACT"}}}, "then": {"required": ["contract_address", "function_id"]}},
        {"if": {"properties": {"route_type": {"const": "APPROVED_PROVIDER"}}}, "then": {"required": ["provider_id"]}}
      ]
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["deadline"],
      "properties": {
        "deadline": {"$ref": "common.schema.json#/$defs/deadline"},
        "max_slippage_bps": {"$ref": "common.schema.json#/$defs/basisPoints"},
        "minimum_output": {"$ref": "common.schema.json#/$defs/amount"},
        "quote_expires_at": {"$ref": "common.schema.json#/$defs/deadline"},
        "destination_chain_id": {"$ref": "common.schema.json#/$defs/chainId"}
      }
    },
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "client_request_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "intent_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "execution_state": {"enum": ["draft", "intent_created", "approval_required", "approved", "execution_queued", "executing", "submitted", "confirming", "verified", "completed", "recovery_required", "failed", "cancelled", "expired", "rejected"]}
  },
  "allOf": [
    {"if": {"properties": {"operation_type": {"const": "PAYROLL"}}}, "then": {"properties": {"financial": {"$ref": "#/$defs/payroll"}}}},
    {"if": {"properties": {"operation_type": {"const": "SWAP"}}}, "then": {"properties": {"financial": {"$ref": "#/$defs/swap"}, "constraints": {"required": ["deadline", "max_slippage_bps", "minimum_output", "quote_expires_at"]}}}},
    {"if": {"properties": {"operation_type": {"const": "BRIDGE"}}}, "then": {"properties": {"financial": {"$ref": "#/$defs/bridge"}, "constraints": {"required": ["deadline", "destination_chain_id", "quote_expires_at"]}}}},
    {"if": {"properties": {"operation_type": {"const": "ANS_REGISTRATION"}}}, "then": {"properties": {"financial": {"$ref": "#/$defs/ans"}}}},
    {"if": {"properties": {"operation_type": {"const": "WITHDRAWAL"}}}, "then": {"properties": {"financial": {"$ref": "#/$defs/withdrawal"}}}}
  ],
  "$defs": {
    "payroll": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "input_token", "recipients", "total"],
      "properties": {
        "kind": {"const": "PAYROLL"},
        "input_token": {"$ref": "common.schema.json#/$defs/token"},
        "recipients": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "common.schema.json#/$defs/recipient"}},
        "total": {"$ref": "common.schema.json#/$defs/amount"},
        "batch_memo_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "swap": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "input_token", "output_token", "input_amount", "expected_output", "minimum_output", "quote_id"],
      "properties": {
        "kind": {"const": "SWAP"},
        "input_token": {"$ref": "common.schema.json#/$defs/token"},
        "output_token": {"$ref": "common.schema.json#/$defs/token"},
        "input_amount": {"$ref": "common.schema.json#/$defs/amount"},
        "expected_output": {"$ref": "common.schema.json#/$defs/amount"},
        "minimum_output": {"$ref": "common.schema.json#/$defs/amount"},
        "quote_id": {"$ref": "common.schema.json#/$defs/opaqueId"}
      }
    },
    "bridge": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source_chain_id", "destination_chain_id", "source_token", "source_amount", "destination_amount", "destination_recipient", "plan_id"],
      "properties": {
        "kind": {"const": "BRIDGE"},
        "source_chain_id": {"$ref": "common.schema.json#/$defs/chainId"},
        "destination_chain_id": {"$ref": "common.schema.json#/$defs/chainId"},
        "source_token": {"$ref": "common.schema.json#/$defs/token"},
        "source_amount": {"$ref": "common.schema.json#/$defs/amount"},
        "destination_amount": {"$ref": "common.schema.json#/$defs/amount"},
        "destination_recipient": {"$ref": "common.schema.json#/$defs/evmAddress"},
        "plan_id": {"$ref": "common.schema.json#/$defs/opaqueId"}
      }
    },
    "ans": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "normalized_name", "normalization_version", "term_seconds", "controller", "cost_token", "cost_amount"],
      "properties": {
        "kind": {"const": "ANS_REGISTRATION"},
        "normalized_name": {"type": "string", "minLength": 1, "maxLength": 255},
        "normalization_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "term_seconds": {"type": "integer", "minimum": 1, "maximum": 315360000},
        "controller": {"$ref": "common.schema.json#/$defs/evmAddress"},
        "cost_token": {"$ref": "common.schema.json#/$defs/token"},
        "cost_amount": {"$ref": "common.schema.json#/$defs/amount"}
      }
    },
    "withdrawal": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "token", "amount", "recipient"],
      "properties": {
        "kind": {"const": "WITHDRAWAL"},
        "token": {"$ref": "common.schema.json#/$defs/token"},
        "amount": {"$ref": "common.schema.json#/$defs/amount"},
        "recipient": {"$ref": "common.schema.json#/$defs/evmAddress"},
        "memo": {"type": "string", "minLength": 1, "maxLength": 140}
      }
    }
  }
}
