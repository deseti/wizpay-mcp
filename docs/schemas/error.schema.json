{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.wizpay.xyz/schemas/error.schema.json",
  "title": "WizPay MCP public error response",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "request_id", "retryable", "user_action_required", "terminal"],
      "properties": {
        "code": {"enum": ["validation_error", "authentication_required", "authorization_required", "identity_not_found", "identity_suspended", "identity_revoked", "approval_required", "approval_expired", "approval_rejected", "policy_denied", "wallet_not_bound", "wallet_mismatch", "wallet_revoked", "unsupported_chain", "unsupported_token", "insufficient_balance", "quote_expired", "route_unavailable", "execution_conflict", "execution_pending", "execution_failed", "receipt_not_confirmed", "receipt_verification_failed", "provider_unavailable", "rate_limited", "internal_error"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 300},
        "request_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "retryable": {"type": "boolean"},
        "user_action_required": {"type": "boolean"},
        "terminal": {"type": "boolean"},
        "retry_after_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "safe_details": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "intent_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
            "execution_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
            "field_paths": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^(/([A-Za-z0-9_-]+|[0-9]+))*$"}},
            "current_state": {"type": "string", "pattern": "^[a-z_]{1,64}$"},
            "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}
          }
        }
      }
    }
  }
}
