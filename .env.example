# Phase 1 supports non-secret process configuration only.
APP_ENV=development
SERVER_PORT=8080
LOG_LEVEL=info

# Local PostgreSQL only. Replace this placeholder in an untracked .env file.
POSTGRES_DB=wizpay_mcp
POSTGRES_USER=wizpay_mcp
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://wizpay_mcp:change-me-local-only@localhost:5432/wizpay_mcp?sslmode=disable
# Set this to a separately managed migration-owner login after role bootstrap.
DATABASE_MIGRATION_URL=postgres://wizpay_mcp:change-me-local-only@localhost:5432/wizpay_mcp?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=5s
