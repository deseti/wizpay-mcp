# Phase 1 supports non-secret process configuration only.
APP_ENV=development
SERVER_PORT=8080
LOG_LEVEL=info
WIZPAY_AUTONOMY_ENABLED=false
AUTH_REQUIRED=false
AUTH_ISSUER=https://identity.example.invalid/
AUTH_AUDIENCE=wizpay-mcp
AUTH_PUBLIC_KEY_FILE=/path/to/identity-provider-public-key.pem
AUTH_CLOCK_SKEW=30s

# Local PostgreSQL only. Replace this placeholder in an untracked .env file.
POSTGRES_DB=wizpay_mcp
POSTGRES_USER=wizpay_mcp
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://wizpay_mcp:change-me-local-only@localhost:5432/wizpay_mcp?sslmode=disable
# Set this to a separately managed migration-owner login after role bootstrap.
DATABASE_MIGRATION_URL=postgres://wizpay_mcp:change-me-local-only@localhost:5432/wizpay_mcp?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=5s

# Phase 11 provider execution boundary. Both providers are disabled by default;
# leaving them disabled keeps the worker idle and makes execution impossible.
# The Circle API key is a secret: never commit a real value. Provide it only
# through an untracked .env file or the deployment secret store.
WIZPAY_CIRCLE_ENABLED=false
WIZPAY_CIRCLE_API_KEY=
WIZPAY_CIRCLE_BASE_URL=https://api.circle.com
WIZPAY_CIRCLE_BLOCKCHAIN=ARC-TESTNET
WIZPAY_CIRCLE_TIMEOUT=20s

# Arc receipt verification is read-only against a single Testnet RPC endpoint.
# Arc uses deterministic BFT finality (committed blocks are irreversible; no
# normal consensus reorgs). Recommended/default confirmations is 1; values
# below 1 are rejected. Canonical RPC is rpc.testnet.arc.io (not .arc.network).
# No mainnet configuration is supported in this phase.
WIZPAY_ARC_ENABLED=false
WIZPAY_ARC_CHAIN_ID=5042002
WIZPAY_ARC_NETWORK=TESTNET
WIZPAY_ARC_RPC_URL=https://rpc.testnet.arc.io
WIZPAY_ARC_EXPLORER_URL=https://testnet.arcscan.app
WIZPAY_ARC_MIN_CONFIRMATIONS=1
WIZPAY_ARC_TIMEOUT=15s

# Optional provider integration harness flags (tests only). Default go test stays
# offline. Never commit real credentials.
# WIZPAY_ARC_INTEGRATION=1
# WIZPAY_CIRCLE_INTEGRATION=1

# Execution worker lease and retry parameters. WIZPAY_WORKER_ID must be stable
# per process so lease ownership and fencing are attributable; it defaults to
# host-pid when unset.
WIZPAY_WORKER_ID=
WIZPAY_WORKER_LEASE_DURATION=30s
WIZPAY_WORKER_RETRY_INTERVAL=5s
